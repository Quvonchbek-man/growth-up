# ─── Majburiy ────────────────────────────────────────────────────────────────
# BotFather'dan olingan token
BOT_TOKEN=

# Sizning Telegram ID'ingiz (@userinfobot aytadi). Bir nechta bo'lsa: 111,222
SUPER_ADMIN_IDS=123456789

# ─── Mini App ────────────────────────────────────────────────────────────────
# Cloudflare tunnel bergan HTTPS manzil. Bot startupda menyu tugmasini
# shu manzilga o'rnatadi — BotFather'ga qo'lda kirish shart emas.
# Tunnel qayta ishga tushsa URL o'zgaradi: shu yerni yangilab, botni restart qiling.
WEBAPP_URL=

# ─── Server ──────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# Vite dev serveri (npm run dev) uchun CORS. Ishlab chiqarishda bo'sh qoldiring.
CORS_ORIGINS=http://localhost:5173

# ─── Baza ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/growth.db

# ─── Vaqt ────────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Tashkent

# Vaqti belgilangan vazifa boshlanishidan necha daqiqa oldin eslatma kelsin.
# Bu yangi foydalanuvchi uchun standart — keyin har kim sozlamalardan
# o'zgartira oladi. 0 — bunday eslatmalar o'chirilgan.
TASK_REMINDER_LEAD_MIN=10

# ─── Ishlab chiqish (PRODUCTION'DA TEGMANG) ──────────────────────────────────
# false bo'lsa Mini App initData imzosi TEKSHIRILMAYDI va har so'rov
# DEV_MOCK_USER_ID nomidan bajariladi. Faqat brauzerda ishlash uchun.
CHECK_INIT_DATA=true
DEV_MOCK_USER_ID=123456789

# Vaqtni sun'iy siljitish (daqiqa). Kun yopilishi va eslatmalarni
# kechgacha kutmasdan sinash uchun. Masalan 600 = 10 soat oldinga.
DEV_TIME_SHIFT_MINUTES=0

# Eslatma siklining qadami (soniya). Sinovda 5 qilib qo'ysa bo'ladi.
REMINDER_TICK_SECONDS=60

LOG_LEVEL=INFO
